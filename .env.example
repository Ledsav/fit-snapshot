# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your apps > Web app
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google OAuth Client ID (Android)
# Get this from Google Cloud Console > APIs & Services > Credentials
# Create OAuth 2.0 Client ID for Android with your package name and SHA-1
ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# Google Cloud Function
CLOUD_FUNCTION_URL=https://your-region-your-project.cloudfunctions.net/generate_gif_http

# RevenueCat (Google Play) public SDK key — from app.revenuecat.com project settings
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_key_here

# Sentry DSN — from sentry.io project settings > Client Keys (DSN). Leave unset
# to disable crash reporting entirely (e.g. local dev).
EXPO_PUBLIC_SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0
