# Copy to .env and fill in. Expo only inlines variables prefixed with EXPO_PUBLIC_.
# EAS cloud builds do NOT read this file — set the same keys with `eas env:set` (see README).

# Firebase web config — Firebase Console (project python-functions-476223)
# > Project settings > General > Your apps > Web app > SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Sign-In — passed to GoogleSignin.configure({ webClientId }), so despite the name
# this must be the WEB OAuth client ID ("Web client (auto created by Google Service)"),
# from Google Cloud Console > APIs & Services > Credentials (same project). It ends in
# .apps.googleusercontent.com. The Android client (package + SHA-1) must also exist there.
EXPO_PUBLIC_ANDROID_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# GIF generator Cloud Function (source: https://github.com/Ledsav/gif-generator)
# Google Cloud Console > Cloud Functions/Cloud Run > generate_gif_http > URL
EXPO_PUBLIC_CLOUD_FUNCTION_URL=https://us-central1-your_project_id.cloudfunctions.net/generate_gif_http

# RevenueCat (Google Play) public SDK key — app.revenuecat.com > Project > API keys (starts with goog_)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_revenuecat_key
